<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The optional Nightmare Mobile local HTTP server binds to a LAN interface. -->
    <application
        android:allowBackup="false"
        android:label="RealFrame AI Studio"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".WebStudioActivity" android:exported="false"/>
        <activity android:name=".LocalVideoActivity" android:exported="false"/>
        <activity android:name=".UnifiedCreateActivity" android:exported="false"/>
        <activity android:name=".LocalImageActivity" android:exported="false"/>
        <activity android:name=".ProductionPlannerActivity" android:exported="false"/>
        <activity android:name=".ModelManagerActivity" android:exported="false"/>
        <activity android:name=".OfflinePhotoLabActivity" android:exported="false"/>
        <activity android:name=".OfflineImageVideoActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".StudioDashboardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".RenderService" android:exported="false" android:foregroundServiceType="dataSync"/>

    </application>
</manifest>
